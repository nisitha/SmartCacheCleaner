{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartCacheCleaner",
  "version": "0.1.0",
  "identifier": "com.pixelcraft.cachecleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SmartCacheCleaner",
        "width": 1160,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Pixel Craft Studios",
    "copyright": "Copyright © 2026 Pixel Craft Studios",
    "category": "Utility",
    "shortDescription": "Zero-Trust Windows Cache & Junk Cleaner",
    "longDescription": "High-speed, offline Windows utility for safely cleaning temporary files, browser caches, and shader caches.",
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
